{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buddystudy-health-monitor",
  "main": "src/index.js",
  "workers_dev": false,
  "compatibility_date": "2026-07-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "HEALTHCHECK_URL": "https://api.ghkdqhrbals.org/api/v1/health/readiness",
    "SERVICE_NAME": "BuddyStudy backend",
    "ENVIRONMENT_NAME": "production",
    "FAILURE_THRESHOLD": "2",
    "ALERT_REPEAT_SECONDS": "3600",
    "STATUS_STALE_AFTER_SECONDS": "180",
    "HEALTHCHECK_TIMEOUT_MS": "3000",
    "SLACK_TIMEOUT_MS": "3000",
    "SCHEDULED_CHECKS_ENABLED": "false",
    "OBSERVABILITY_URL": "https://grafana.ghkdqhrbals.org"
  },
  "kv_namespaces": [
    {
      "binding": "HEALTH_MONITOR_STATE",
      "id": "2a868dcc414f4db0a8616c1c633f10b6"
    }
  ]
}
