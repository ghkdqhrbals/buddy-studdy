            "desc": true,
            "displayName": "p99"
          }
        ]
      },
      "pluginVersion": "12.3.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "buddystudy-loki"
          },
          "editorMode": "code",
          "expr": "topk(100, quantile_over_time(0.50, ${labelSelector:raw} |= \"api_exchange\" ${logqlSearch:raw} | regexp `\"method\":\"(?P<method>[^\"]+)\".*\"path\":\"(?P<path>[^\"]+)\".*\"durationMs\":\"?(?P<durationMs>[0-9.]+)` | label_format api=\"{{.method}} {{.path}}\" | unwrap durationMs [$__range]) by (api))",
          "legendFormat": "p50",
          "queryType": "range",
          "refId": "P50"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "buddystudy-loki"
          },
          "editorMode": "code",
          "expr": "topk(100, quantile_over_time(0.90, ${labelSelector:raw} |= \"api_exchange\" ${logqlSearch:raw} | regexp `\"method\":\"(?P<method>[^\"]+)\".*\"path\":\"(?P<path>[^\"]+)\".*\"durationMs\":\"?(?P<durationMs>[0-9.]+)` | label_format api=\"{{.method}} {{.path}}\" | unwrap durationMs [$__range]) by (api))",
          "legendFormat": "p90",
          "queryType": "range",
          "refId": "P90"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "buddystudy-loki"
          },
          "editorMode": "code",
          "expr": "topk(100, quantile_over_time(0.95, ${labelSelector:raw} |= \"api_exchange\" ${logqlSearch:raw} | regexp `\"method\":\"(?P<method>[^\"]+)\".*\"path\":\"(?P<path>[^\"]+)\".*\"durationMs\":\"?(?P<durationMs>[0-9.]+)` | label_format api=\"{{.method}} {{.path}}\" | unwrap durationMs [$__range]) by (api))",
          "legendFormat": "p95",
          "queryType": "range",
          "refId": "P95"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "buddystudy-loki"
          },
          "editorMode": "code",
          "expr": "topk(100, quantile_over_time(0.99, ${labelSelector:raw} |= \"api_exchange\" ${logqlSearch:raw} | regexp `\"method\":\"(?P<method>[^\"]+)\".*\"path\":\"(?P<path>[^\"]+)\".*\"durationMs\":\"?(?P<durationMs>[0-9.]+)` | label_format api=\"{{.method}} {{.path}}\" | unwrap durationMs [$__range]) by (api))",
          "legendFormat": "p99",
          "queryType": "range",
          "refId": "P99"
        }
      ],
