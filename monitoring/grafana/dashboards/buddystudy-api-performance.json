              {
                "id": "custom.width",
                "value": 430
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p50"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p90"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p90"
              },
              {
                "id": "custom.width",
                "value": 100
              }
