    {
      "datasource": {
        "type": "loki",
        "uid": "buddystudy-loki"
      },
      "description": "Current backend API request throughput calculated from structured api_exchange logs over the latest minute.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(({container=~\"buddystudy-backend.*\"} |= \"api_exchange \")[1m])) or (sum(rate(({container=~\"buddystudy-backend.*\"} |= \"runtime_metrics \")[1m])) * 0)",
          "legendFormat": "requests",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "buddystudy-loki"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
