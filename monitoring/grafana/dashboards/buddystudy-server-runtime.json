      "targets": [
        {
          "expr": "max(last_over_time({app=\"buddystudy\"} |= \"runtime_metrics \" | pattern \"<_> runtime_metrics <runtime>\" | line_format \"{{.runtime}}\" | drop runtime | json processCpuPercent=\"processCpuPercent\" | unwrap processCpuPercent | __error__=\"\" [1m]))",
          "legendFormat": "process",
