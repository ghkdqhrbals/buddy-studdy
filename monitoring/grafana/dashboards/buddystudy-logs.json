        {
          "datasource": {
            "type": "loki",
            "uid": "buddystudy-loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "${labelSelector:raw} |= \"api_exchange\" ${logqlSearch:raw} | regexp `api_exchange \\{\"requestId\":\"(?P<requestId>[^\"]+)\",\"clientIp\":\"(?P<clientIp>[^\"]*)\".*\"method\":\"(?P<method>[^\"]+)\".*\"path\":\"(?P<path>[^\"]+)\".*\"status\":(?P<status>[0-9]+).*\"durationMs\":\"?(?P<durationMs>[0-9.]+).*?(?:\"code\":\"(?P<errorCode>[^\"]+)\")?.*?(?:\"reason\":\"(?P<reason>[^\"]+)\")?` | line_format `method={{.method}} path={{.path}} status={{.status}} durationMs={{.durationMs}} errorCode={{.errorCode}} reason={{.reason}} clientIp={{.clientIp}} requestId={{.requestId}}`",
          "maxLines": 500,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "API Requests",
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "NewField",
            "format": "regexp",
            "regexp": "method=(?<method>\\S+) path=(?<path>\\S+) status=(?<status>\\d+) durationMs=(?<durationMs>[0-9.]+) errorCode=(?<errorCode>.*?) reason=(?<reason>.*?) clientIp=(?<clientIp>\\S*) requestId=(?<requestId>[0-9a-fA-F-]+)",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "regexp",
            "regexp": "method=(?<method>\\S+) path=(?<path>\\S+) status=(?<status>\\d+) durationMs=(?<durationMs>[0-9.]+) errorCode=(?<errorCode>.*?) reason=(?<reason>.*?) clientIp=(?<clientIp>\\S*) requestId=(?<requestId>[0-9a-fA-F-]+)",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "NewField": true,
              "Line": true,
              "labels": true
            },
            "indexByName": {
              "Time": 0,
              "method": 1,
              "path": 2,
              "status": 3,
              "durationMs": 4,
              "errorCode": 5,
              "reason": 6,
              "clientIp": 7,
              "requestId": 8
            },
            "renameByName": {
              "Time": "time"
            }
          }
        }
      ],
      "type": "table",
      "description": "Sentry-style API request list. Click any value in a request row to open logs connected by requestId."
