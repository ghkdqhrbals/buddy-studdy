            "uid": "buddystudy-loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "${labelSelector:raw} |= \"api_exchange\" ${logqlSearch:raw} | regexp \"api_exchange \\\\{\\\"requestId\\\":\\\"(?P<requestId>[^\\\"]+)\\\".*\\\"method\\\":\\\"(?P<method>[^\\\"]+)\\\".*\\\"path\\\":\\\"(?P<path>[^\\\"]+)\\\".*\\\"status\\\":(?P<status>[0-9]+).*\\\"durationMs\\\":\\\"?(?P<durationMs>[0-9.]+)\" | line_format \"method={{.method}} path={{.path}} status={{.status}} durationMs={{.durationMs}} requestId={{.requestId}}\"",
          "maxLines": 300,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "API Requests",
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "regexp",
            "regexp": "method=(?<method>\\S+) path=(?<path>\\S+) status=(?<status>\\d+) durationMs=(?<durationMs>[0-9.]+) requestId=(?<requestId>[0-9a-fA-F-]+)",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "Time": 0,
              "method": 1,
              "path": 2,
              "status": 3,
              "durationMs": 4,
              "requestId": 5
            },
            "renameByName": {
              "Time": "time"
            }
          }
        }
      ],
