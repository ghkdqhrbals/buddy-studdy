{
  "name": "buddystudy-local-monitoring",
  "services": {
    "loki": {
      "image": "grafana/loki:3.3.2",
      "command": [
        "-config.file=/etc/loki/local-config.yaml"
      ],
      "ports": [
        "127.0.0.1:3100:3100"
      ],
      "volumes": [
        "loki-data:/loki",
        "../loki/config/loki.yml:/etc/loki/local-config.yaml:ro"
      ],
      "restart": "unless-stopped",
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "promtail": {
      "image": "grafana/promtail:3.3.2",
      "command": [
        "-config.file=/etc/promtail/config.yml"
      ],
      "volumes": [
        "./promtail.yml:/etc/promtail/config.yml:ro",
        "/var/run/docker.sock:/var/run/docker.sock:ro",
        "positions:/positions"
      ],
      "depends_on": [
        "loki"
      ],
      "restart": "unless-stopped",
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "dashboard": {
      "image": "nginx:1.27-alpine",
      "ports": [
        "127.0.0.1:3000:80"
      ],
      "volumes": [
        "./public:/usr/share/nginx/html:ro",
        "./nginx.conf:/etc/nginx/conf.d/default.conf:ro"
      ],
      "networks": [
        "default",
        "backend"
      ],
      "depends_on": [
        "loki"
      ],
      "restart": "unless-stopped",
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  },
  "volumes": {
    "loki-data": {},
    "positions": {}
  },
  "networks": {
    "backend": {
      "external": true,
      "name": "backend_default"
    }
  }
}
